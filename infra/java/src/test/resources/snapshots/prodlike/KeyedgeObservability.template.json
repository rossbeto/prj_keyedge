Description: 'keyedge prodlike: alarms'
Parameters:
  BootstrapVersion: {Type: 'AWS::SSM::Parameter::Value<String>', Default: /cdk-bootstrap/hnb659fds/version,
    Description: 'Version of the CDK Bootstrap resources in this environment, automatically
      retrieved from SSM Parameter Store. [cdk:skip]'}
Resources:
  SeveritycriticalE579328D:
    Type: AWS::SNS::Topic
    Properties:
      Tags:
      - {Key: env, Value: prodlike}
      - {Key: project, Value: keyedge}
      TopicName: keyedge-prodlike-critical
  SeveritycriticalPolicyA38889A4:
    Type: AWS::SNS::TopicPolicy
    Properties:
      PolicyDocument:
        Statement:
        - Action: sns:Publish
          Condition:
            Bool: {'aws:SecureTransport': 'false'}
          Effect: Deny
          Principal: '*'
          Resource: {Ref: SeveritycriticalE579328D}
          Sid: AllowPublishThroughSSLOnly
        Version: '2012-10-17'
      Topics:
      - {Ref: SeveritycriticalE579328D}
  Severityhigh2DE861BC:
    Type: AWS::SNS::Topic
    Properties:
      Tags:
      - {Key: env, Value: prodlike}
      - {Key: project, Value: keyedge}
      TopicName: keyedge-prodlike-high
  SeverityhighPolicy37B1CCF5:
    Type: AWS::SNS::TopicPolicy
    Properties:
      PolicyDocument:
        Statement:
        - Action: sns:Publish
          Condition:
            Bool: {'aws:SecureTransport': 'false'}
          Effect: Deny
          Principal: '*'
          Resource: {Ref: Severityhigh2DE861BC}
          Sid: AllowPublishThroughSSLOnly
        Version: '2012-10-17'
      Topics:
      - {Ref: Severityhigh2DE861BC}
  Severitymedium4D75FA7A:
    Type: AWS::SNS::Topic
    Properties:
      Tags:
      - {Key: env, Value: prodlike}
      - {Key: project, Value: keyedge}
      TopicName: keyedge-prodlike-medium
  SeveritymediumPolicy9E63C2E3:
    Type: AWS::SNS::TopicPolicy
    Properties:
      PolicyDocument:
        Statement:
        - Action: sns:Publish
          Condition:
            Bool: {'aws:SecureTransport': 'false'}
          Effect: Deny
          Principal: '*'
          Resource: {Ref: Severitymedium4D75FA7A}
          Sid: AllowPublishThroughSSLOnly
        Version: '2012-10-17'
      Topics:
      - {Ref: Severitymedium4D75FA7A}
  SeverityEdge5xx14DBEA0C:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions:
      - {Ref: SeveritycriticalE579328D}
      AlarmDescription: '[critical] edge 5xx above 5 % (runbook §1)'
      ComparisonOperator: GreaterThanThreshold
      EvaluationPeriods: 3
      Metrics:
      - {Expression: '100 * (elb + target) / MAX([requests, 1])', Id: expr_1, Label: 5xx
          %, ReturnData: true}
      - Id: elb
        MetricStat:
          Metric:
            Dimensions:
            - Name: LoadBalancer
              Value: {'Fn::ImportValue': 'KeyedgeEdgeLb:ExportsOutputFnGetAttAlb16C2F182LoadBalancerFullName73BA17C5'}
            MetricName: HTTPCode_ELB_5XX_Count
            Namespace: AWS/ApplicationELB
          Period: 60
          Stat: Sum
        ReturnData: false
      - Id: requests
        MetricStat:
          Metric:
            Dimensions:
            - Name: LoadBalancer
              Value: {'Fn::ImportValue': 'KeyedgeEdgeLb:ExportsOutputFnGetAttAlb16C2F182LoadBalancerFullName73BA17C5'}
            MetricName: RequestCount
            Namespace: AWS/ApplicationELB
          Period: 60
          Stat: Sum
        ReturnData: false
      - Id: target
        MetricStat:
          Metric:
            Dimensions:
            - Name: LoadBalancer
              Value: {'Fn::ImportValue': 'KeyedgeEdgeLb:ExportsOutputFnGetAttAlb16C2F182LoadBalancerFullName73BA17C5'}
            MetricName: HTTPCode_Target_5XX_Count
            Namespace: AWS/ApplicationELB
          Period: 60
          Stat: Sum
        ReturnData: false
      Tags:
      - {Key: env, Value: prodlike}
      - {Key: project, Value: keyedge}
      Threshold: 5
      TreatMissingData: notBreaching
  SeverityEdgeLatency21C0CBB6:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions:
      - {Ref: Severityhigh2DE861BC}
      AlarmDescription: '[high] edge p99 above 500 ms'
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
      - Name: LoadBalancer
        Value: {'Fn::ImportValue': 'KeyedgeEdgeLb:ExportsOutputFnGetAttAlb16C2F182LoadBalancerFullName73BA17C5'}
      EvaluationPeriods: 3
      ExtendedStatistic: p99
      MetricName: TargetResponseTime
      Namespace: AWS/ApplicationELB
      Period: 60
      Tags:
      - {Key: env, Value: prodlike}
      - {Key: project, Value: keyedge}
      Threshold: 0.5
      TreatMissingData: notBreaching
Rules:
  CheckBootstrapVersion:
    Assertions:
    - Assert:
        Fn::Not:
        - Fn::Contains:
          - ['1', '2', '3', '4', '5']
          - {Ref: BootstrapVersion}
      AssertDescription: CDK bootstrap stack version 6 required. Please run 'cdk bootstrap'
        with a recent version of the CDK CLI.
